# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s

--- |
  define i16 @peephole() {
    ret i16 0
  }
...
---
name: peephole
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r1 = IMPLICIT_DEF
    renamable $r2 = IMPLICIT_DEF
    renamable $r3 = IMPLICIT_DEF
    renamable $r4 = IMPLICIT_DEF
    renamable $r5 = IMPLICIT_DEF
    renamable $r7 = IMPLICIT_DEF
    renamable $r1 = AI killed $r1, 1, implicit-def dead $st
    renamable $r2 = AI killed $r2, 2, implicit-def dead $st
    renamable $r3 = AI killed $r3, -1, implicit-def dead $st
    renamable $r4 = AI killed $r4, -2, implicit-def dead $st
    renamable $r5 = AI killed $r5, 0, implicit-def dead $st
    renamable $r6 = LI 0, implicit-def dead $st
    renamable $r7 = XORrr killed $r7, $r7, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: peephole
# CHECK: INCr
# CHECK: INCTr
# CHECK: DECr
# CHECK: DECTr
# CHECK-NOT: AI
# CHECK: CLRr
# CHECK: CLRr
