# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s

--- |
  define void @postinc() {
    ret void
  }
...
---
name: postinc
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r1 = IMPLICIT_DEF
    renamable $r2 = IMPLICIT_DEF
    renamable $r3 = IMPLICIT_DEF
    renamable $r4 = IMPLICIT_DEF
    renamable $r5 = IMPLICIT_DEF
    renamable $r6 = IMPLICIT_DEF

    renamable $r0 = MOVim $r1, implicit-def dead $st
    renamable $r1 = AI killed $r1, 2, implicit-def dead $st

    MOVmi $r2, killed $r3, implicit-def dead $st
    renamable $r2 = INCTr killed $r2, implicit-def dead $st

    renamable $r4 = MOVBim $r5, implicit-def dead $st
    renamable $r5 = AI killed $r5, 1, implicit-def dead $st

    MOVBmi $r6, killed $r0, implicit-def dead $st
    renamable $r6 = INCr killed $r6, implicit-def dead $st

    RET
...

# CHECK-LABEL: name: postinc
# CHECK: MOVpim
# CHECK: MOVmpi
# CHECK: MOVBpim
# CHECK: MOVBmpi
