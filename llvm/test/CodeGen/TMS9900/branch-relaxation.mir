# RUN: llc -mtriple=tms9900 -run-pass branch-relaxation %s -o - | FileCheck %s

--- |
  define void @relax_long_cond() {
    ret void
  }
  define void @relax_long_cond_no() {
    ret void
  }
  define void @relax_long_cond_op() {
    ret void
  }
...
---
name: relax_long_cond
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    JEQ %bb.2, implicit $st
    JMP %bb.1

