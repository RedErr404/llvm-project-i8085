---
name: relax_long_cond_no
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    JNO %bb.2, implicit $st
    JMP %bb.1

  bb.1:
    successors: %bb.2
    $r1 = IMPLICIT_DEF
    renamable $r1 = MOVrr $r1, implicit-def $st
