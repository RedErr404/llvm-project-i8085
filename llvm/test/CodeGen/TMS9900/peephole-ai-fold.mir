# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s
#
# Extended tests for AI -> INC/DEC/INCT/DECT folding in the peephole pass.
# The existing peephole.mir tests the basic +1/+2/-1/-2 and 0 cases.
# This file adds:
#   - AI with large positive/negative values (should NOT be folded)
#   - AI 0 removal when ST is dead
#   - AI 0 retention when ST is live (should NOT be removed)

--- |
  define i16 @ai_large_no_fold() { ret i16 0 }
  define i16 @ai_zero_dead_st() { ret i16 0 }
  define i16 @ai_zero_live_st() { ret i16 0 }
...

# AI with values other than +/-1, +/-2 should NOT be folded.
---
name: ai_large_no_fold
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r1 = IMPLICIT_DEF
    renamable $r2 = IMPLICIT_DEF
    renamable $r3 = IMPLICIT_DEF
    renamable $r1 = AI killed $r1, 10, implicit-def dead $st
    renamable $r2 = AI killed $r2, -10, implicit-def dead $st
    renamable $r3 = AI killed $r3, 100, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: ai_large_no_fold
# These should all remain as AI because their immediates are not +/-1 or +/-2.
# CHECK: AI {{.*}}10
# CHECK: AI {{.*}}-10
# CHECK: AI {{.*}}100
# CHECK: RET

# AI 0 removal when status flags are dead.
---
name: ai_zero_dead_st
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r5 = IMPLICIT_DEF
    renamable $r5 = AI killed $r5, 0, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: ai_zero_dead_st
# AI 0 with dead ST should be removed entirely.
# CHECK-NOT: AI
# CHECK: RET

# AI 0 retention when status flags are live.
---
name: ai_zero_live_st
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    renamable $r5 = IMPLICIT_DEF
    renamable $r5 = AI killed $r5, 0, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: ai_zero_live_st
# AI 0 with live ST (used by JEQ) should NOT be removed.
# CHECK: AI {{.*}}0
# CHECK: JEQ
