# CHECK-LABEL: name: relax_long_signed
# CHECK: bb.0:
# CHECK: JGT %bb.[[LONG:[0-9]+]], implicit $st
# CHECK-NEXT: JMP %bb.1
# CHECK: bb.[[LONG]]:
# CHECK: B_sym %bb.2
