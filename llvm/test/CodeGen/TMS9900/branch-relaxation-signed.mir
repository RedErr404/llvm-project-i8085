# RUN: llc -mtriple=tms9900 -run-pass branch-relaxation %s -o - | FileCheck %s

--- |
  define void @relax_long_signed() {
    ret void
  }
...
---
name: relax_long_signed
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    JGT %bb.2, implicit $st
    JMP %bb.1

  bb.1:
    successors: %bb.2
    $r1 = IMPLICIT_DEF
    renamable $r1 = MOVrr $r1, implicit-def $st
