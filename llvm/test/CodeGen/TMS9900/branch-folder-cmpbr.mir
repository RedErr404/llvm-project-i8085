# RUN: llc -mtriple=tms9900 -run-pass=branch-folder %s -o - | FileCheck %s
# RUN: llc -mtriple=tms9900 -run-pass=machine-scheduler -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=MSCHED

--- |
  define i16 @cmpbr_invert() {
    ret i16 0
  }
...
---
name: cmpbr_invert
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    $r1 = IMPLICIT_DEF
    $r2 = IMPLICIT_DEF
    CMPBRrr $r1, $r2, 17, %bb.1
    JMP %bb.2

  bb.1:
    renamable $r0 = LI 1, implicit-def $st
    RET

  bb.2:
    renamable $r0 = LI 2, implicit-def $st
    RET
...

# CHECK-LABEL: name: cmpbr_invert
# CHECK: bb.0:
# NOTE: branch-folder may invert CMPBRrr to remove the following JMP.
# CHECK: CMPBRrr $r{{[0-9]+}}, $r{{[0-9]+}}, 22, %bb.2
# MSCHED-LABEL: name: cmpbr_invert
# MSCHED: CMPBRrr
