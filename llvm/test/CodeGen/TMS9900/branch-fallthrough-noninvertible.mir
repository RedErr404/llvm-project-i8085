# RUN: llc -mtriple=tms9900 -run-pass=block-placement -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @noninvertible_fallthrough() {
    ret void
  }
...
---
name: noninvertible_fallthrough
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x7fffffff), %bb.2(0x00000001)
    $r1 = IMPLICIT_DEF
    $r2 = IMPLICIT_DEF
    Crr $r1, $r2, implicit-def $st
    JGT %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: noninvertible_fallthrough
# CHECK: bb.0:
# CHECK: Crr $r{{[0-9]+}}, $r{{[0-9]+}}, implicit-def $st
# CHECK-NEXT: JGT %bb.2, implicit $st
# CHECK-NEXT: JMP %bb.1
