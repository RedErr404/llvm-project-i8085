# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s
#
# Tests for CB (compare byte) folding in the peephole pass.
#
# When two registers are loaded via MOVB (byte in HIGH position),
# shifted right by 8 (byte to LOW position), and then compared
# with Crr, the SRL+SRL+Crr sequence can be replaced with CBrr
# which compares the HIGH bytes directly.
#
# Pattern:
#   MOVB *Ra, Rx           ; byte in HIGH position
#   MOVB *Rb, Ry           ; byte in HIGH position
#   SRLri Rx, 8            ; byte to LOW position
#   SRLri Ry, 8            ; byte to LOW position
#   Crr Rx, Ry             ; compare words
#   Jcc target
#
# Becomes:
#   MOVB *Ra, Rx           ; byte in HIGH position
#   MOVB *Rb, Ry           ; byte in HIGH position
#   CBrr Rx, Ry            ; compare HIGH bytes
#   Jcc target
#
# Saves 8 bytes and ~56 cycles (two SRL instructions removed).

--- |
  define i16 @cb_basic_jeq() { ret i16 0 }
  define i16 @cb_basic_jne() { ret i16 0 }
  define i16 @cb_basic_jhe() { ret i16 0 }
  define i16 @cb_basic_jh() { ret i16 0 }
  define i16 @cb_basic_jl() { ret i16 0 }
  define i16 @cb_basic_jle() { ret i16 0 }
  define i16 @cb_basic_jgt() { ret i16 0 }
  define i16 @cb_basic_jlt() { ret i16 0 }
  define i16 @cb_no_fold_not_killed() { ret i16 0 }
  define i16 @cb_no_fold_not_srl() { ret i16 0 }
  define i16 @cb_no_fold_srl_not_8() { ret i16 0 }
  define i16 @cb_no_fold_intervening_use() { ret i16 0 }
  define i16 @cb_no_fold_same_reg() { ret i16 0 }
  define i16 @cb_no_fold_st_live() { ret i16 0 }
  define i16 @cb_srls_separated() { ret i16 0 }
...

# Basic case: MOVB + MOVB + SRL + SRL + Crr + JEQ -> MOVB + MOVB + CBrr + JEQ
---
name: cb_basic_jeq
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    renamable $r0 = MOVBim killed $r0, implicit-def dead $st
    renamable $r1 = MOVBim killed $r1, implicit-def dead $st
    renamable $r0 = SRLri killed $r0, 8, implicit-def dead $st
    renamable $r1 = SRLri killed $r1, 8, implicit-def dead $st
    Crr killed $r1, killed $r0, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: cb_basic_jeq
# Both SRLs should be removed and Crr replaced with CBrr:
# CHECK: MOVBim
# CHECK: MOVBim
# CHECK-NOT: SRLri
# CHECK: CBrr
# CHECK: JEQ

# Same with JNE branch
---
name: cb_basic_jne
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    renamable $r0 = MOVBim killed $r0, implicit-def dead $st
    renamable $r1 = MOVBim killed $r1, implicit-def dead $st
    renamable $r0 = SRLri killed $r0, 8, implicit-def dead $st
    renamable $r1 = SRLri killed $r1, 8, implicit-def dead $st
    Crr killed $r1, killed $r0, implicit-def $st
    JNE %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: cb_basic_jne
# CHECK-NOT: SRLri
# CHECK: CBrr
# CHECK: JNE

# Unsigned comparison: JHE (unsigned >=)
---
name: cb_basic_jhe
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    renamable $r0 = MOVBim killed $r0, implicit-def dead $st
    renamable $r1 = MOVBim killed $r1, implicit-def dead $st
    renamable $r0 = SRLri killed $r0, 8, implicit-def dead $st
    renamable $r1 = SRLri killed $r1, 8, implicit-def dead $st
    Crr killed $r1, killed $r0, implicit-def $st
    JHE %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: cb_basic_jhe
# CHECK-NOT: SRLri
# CHECK: CBrr
# CHECK: JHE

