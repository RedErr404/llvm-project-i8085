# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s
#
# Extended tests for MOV Rx,Rx self-move deletion.
# The existing peephole.mir tests basic self-move elimination.
# This file adds:
#   - Multiple self-moves in sequence
#   - Self-move with live ST and no prior flag-setter (should NOT be deleted)
#   - Self-move with live ST and prior flag-setter (SHOULD be deleted)
#   - Non-self MOV should be kept

--- |
  define i16 @multi_self_mov() { ret i16 0 }
  define i16 @self_mov_live_st() { ret i16 0 }
  define i16 @self_mov_live_st_prior_flags() { ret i16 0 }
  define i16 @self_mov_live_st_xor() { ret i16 0 }
  define i16 @self_mov_live_st_no_st_setter() { ret i16 0 }
  define i16 @non_self_mov() { ret i16 0 }
...

# Multiple consecutive self-moves should all be deleted.
---
name: multi_self_mov
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r1 = IMPLICIT_DEF
    renamable $r2 = IMPLICIT_DEF
    $r1 = MOVrr $r1, implicit-def dead $st
    $r2 = MOVrr $r2, implicit-def dead $st
    $r1 = MOVrr $r1, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: multi_self_mov
# All self-moves should be deleted.
# CHECK-NOT: MOVrr
# CHECK: RET

# Self-move with live ST should NOT be deleted (it sets flags).
---
name: self_mov_live_st
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    renamable $r3 = IMPLICIT_DEF
    $r3 = MOVrr $r3, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: self_mov_live_st
# ST is live (used by JEQ) and preceding IMPLICIT_DEF does NOT set ST,
# so MOVrr must be kept.
# CHECK: MOVrr
# CHECK: JEQ

# Self-move with live ST, preceded by DEC which sets flags on same reg.
# The DEC already set EQ/LGT/AGT correctly, so the self-MOV is redundant.
---
name: self_mov_live_st_prior_flags
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3
    $r3 = DECr $r3, implicit-def dead $st
    $r3 = MOVrr $r3, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: self_mov_live_st_prior_flags
# DEC sets flags on R3, so MOVrr R3,R3 is redundant.
# CHECK: DECr
# CHECK-NOT: MOVrr
# CHECK: JEQ

# Self-move with live ST, preceded by XOR which sets flags on same reg.
---
name: self_mov_live_st_xor
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    $r3 = XORrr $r3, killed $r4, implicit-def dead $st
    $r3 = MOVrr $r3, implicit-def $st
    $r4 = MOVrr $r3, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: self_mov_live_st_xor
# XOR sets flags on R3, so MOVrr R3,R3 is redundant.
# CHECK: XORrr
# CHECK-NOT: $r3 = MOVrr $r3
# CHECK: $r4 = MOVrr $r3
# CHECK: RET

# Self-move with live ST, preceded by MOV from different reg (no flags on Dst).
---
name: self_mov_live_st_no_st_setter
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r5
    $r3 = MOVrr $r5, implicit-def dead $st
    $r3 = MOVrr $r3, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: self_mov_live_st_no_st_setter
# Preceding MOV R5->R3 sets flags based on R5 value, which equals R3's
# new value. Operand 0 IS R3 and it IS a def. Prior does set ST.
# So the self-MOV IS redundant and should be deleted.
# CHECK: $r3 = MOVrr $r5
# CHECK-NOT: $r3 = MOVrr $r3
# CHECK: JEQ

# Non-self MOV should always be kept.
---
name: non_self_mov
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r4 = IMPLICIT_DEF
    renamable $r5 = MOVrr killed $r4, implicit-def dead $st
    RET
...

# CHECK-LABEL: name: non_self_mov
# R4 -> R5 is not a self-move and must remain.
# CHECK: MOVrr
# CHECK: RET
