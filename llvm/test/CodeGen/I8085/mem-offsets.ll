; Large stack offsets and mixed-width loads/stores.

define i8 @stack_large_i8() {
; CHECK-LABEL: stack_large_i8:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0: ; %entry
; CHECK-NEXT:    LXI H, 65024
; CHECK-NEXT:    DAD SP
; CHECK-NEXT:    SPHL
; CHECK-NEXT:    .cfi_adjust_cfa_offset 512
; CHECK-NEXT:    LXI H, 0
; CHECK-NEXT:    DAD SP
; CHECK-NEXT:    MOV B, H
; CHECK-NEXT:    MOV C, L
; CHECK-NEXT:    MVI A, 42
; CHECK-NEXT:    LXI H, 300
; CHECK-NEXT:    DAD B
; CHECK-NEXT:    MOV M, A
; CHECK-NEXT:    LXI H, 512
; CHECK-NEXT:    DAD SP
; CHECK-NEXT:    SPHL
; CHECK-NEXT:    .cfi_adjust_cfa_offset 4294966784
; CHECK-NEXT:    RET
entry:
  %buf = alloca [512 x i8], align 1
  %p = getelementptr [512 x i8], ptr %buf, i16 0, i16 300
  store i8 42, ptr %p, align 1
  %v = load i8, ptr %p, align 1
  ret i8 %v
}

